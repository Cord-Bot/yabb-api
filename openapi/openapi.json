{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "BirthdayRequestDTO" : {
        "type" : "object",
        "required" : [ "guildId", "userId", "month", "day", "zoneId" ],
        "properties" : {
          "guildId" : {
            "type" : "integer",
            "format" : "int64",
            "examples" : [ 123456789012345678 ],
            "exclusiveMinimum" : 0
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64",
            "examples" : [ 987654321098765432 ],
            "exclusiveMinimum" : 0
          },
          "month" : {
            "type" : "integer",
            "format" : "int32",
            "examples" : [ 8 ]
          },
          "day" : {
            "type" : "integer",
            "format" : "int32",
            "examples" : [ 29 ]
          },
          "zoneId" : {
            "type" : "string",
            "examples" : [ "Asia/Kolkata" ]
          }
        }
      },
      "BirthdayResponseDTO" : {
        "type" : "object",
        "required" : [ "guildId", "userId", "month", "day", "zoneId", "nextBirthdayAt" ],
        "properties" : {
          "guildId" : {
            "type" : "integer",
            "format" : "int64",
            "readOnly" : true,
            "examples" : [ 123456789012345678 ]
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64",
            "readOnly" : true,
            "examples" : [ 987654321098765432 ]
          },
          "month" : {
            "type" : "integer",
            "format" : "int32",
            "readOnly" : true,
            "examples" : [ 8 ]
          },
          "day" : {
            "type" : "integer",
            "format" : "int32",
            "readOnly" : true,
            "examples" : [ 29 ]
          },
          "zoneId" : {
            "type" : "string",
            "description" : "IANA time zone ID",
            "readOnly" : true,
            "examples" : [ "Asia/Kolkata" ]
          },
          "nextBirthdayAt" : {
            "$ref" : "#/components/schemas/Instant",
            "description" : "Next scheduled birthday notification time in UTC",
            "type" : "string",
            "examples" : [ "2027-08-28T18:30:00Z" ]
          }
        }
      },
      "ErrorResponse" : {
        "description" : "Standard API error response",
        "type" : "object",
        "required" : [ "status", "error", "message", "timeStamp", "path" ],
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "readOnly" : true
          },
          "error" : {
            "type" : "string",
            "readOnly" : true
          },
          "message" : {
            "type" : "string",
            "readOnly" : true
          },
          "timeStamp" : {
            "$ref" : "#/components/schemas/OffsetDateTime",
            "readOnly" : true,
            "type" : "string",
            "examples" : [ "2026-10-13T05:09:08.496915684+05:30" ]
          },
          "path" : {
            "type" : "string",
            "readOnly" : true
          }
        }
      },
      "GuildDTO" : {
        "type" : "object",
        "required" : [ "guildId", "channelId" ],
        "properties" : {
          "guildId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Discord guild/server ID",
            "examples" : [ 123456789012345678 ],
            "exclusiveMinimum" : 0
          },
          "channelId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Discord channel ID where birthday notifications are sent",
            "examples" : [ 987654321098765432 ],
            "exclusiveMinimum" : 0
          },
          "roleId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Discord role ID to ping when birthday notifications are sent",
            "examples" : [ 1234567891051454842 ],
            "exclusiveMinimum" : 0
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "OffsetDateTime" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T12:15:50-04:00" ]
      }
    }
  },
